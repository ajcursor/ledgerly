# Ledgerly does not need environment variables for the happy path.
# Prisma SQLite is file:./dev.db relative to prisma/schema.prisma.
# Copy this file only if you add a secret later — never commit one.

# Browser DSN. Required for events captured in the browser.
# Leave empty and Sentry stays uninitialized: nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=

# Server and edge DSN. When empty, the server uses NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=

# Optional. Reported as the Sentry environment, for example demo or production.
SENTRY_ENVIRONMENT=

# Optional source map upload. `next build` uploads maps only when the token,
# org slug, and project slug are all set. The token stays out of git.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set to true to enable GET /api/demo/trigger-error. Any other value returns 404.
DEMO_MODE=

# Comma-separated bug ids from demo/bugs.json. Unset keeps today's planted set:
# credit_v1 and filter_state, which is 1 failed test.
# DEMO_BUGS=credit_v1,filter_state

# Preset when DEMO_BUGS is unset: known, ambiguous, new, or all.
# DEMO_SCENARIO=ambiguous

# JSON file with { "bugs": ["..."] } or { "scenario": "known" }.
# Used when DEMO_BUGS and DEMO_SCENARIO are unset.
# DEMO_BUGS_FILE=demo/scenarios/ambiguous.json

# Browser copy of the bug list. `npm run demo:reset` sets this from the chosen set.
# NEXT_PUBLIC_DEMO_BUGS=credit_v1,filter_state
