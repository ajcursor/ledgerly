{
  "name": "ce-field-demos",
  "version": "1.0.0",
  "private": true,
  "description": "Ledgerly — fictional B2B billing and collections ops SaaS for Grok Build demos.",
  "repository": {
    "type": "git",
    "url": "https://github.com/joatmon08x/ce-field-demos.git"
  },
  "scripts": {
    "dev": "next dev --port 43173",
    "build": "next build",
    "start": "next start --port 43173",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "demo:session": "tsx scripts/demo-reset.ts",
    "demo:reset": "tsx scripts/demo-reset.ts reset",
    "runbooks:export": "tsx scripts/export-runbooks.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  }
}
